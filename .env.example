# Cash Flow Copilot — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ---------- NVIDIA Nemotron (hosted) ----------
# Key from build.nvidia.com (free tier, ~40 requests/min per key)
NVIDIA_API_KEY=
# Base URL decides which model server we talk to (NVIDIA hosted or local).
# Local fallback: http://localhost:8080/v1 (llama.cpp llama-server) or http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model names per agent role
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b   # Explainer, Action
NEMOTRON_LIGHTNING_MODEL=                                # Planner, Critic (confirm exact ID in NVIDIA catalog)

# # Optional Nemotron Nano for naming spending groups. Needs a GPU, so not on the EC2 free tier:
# # point at a teammate's machine or a GPU instance. Without it, use rule-based category names.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=                                         # e.g. Nano 4B or 30B tag from Ollama
# LOCAL_LLM_API_KEY=not-needed

# Sampling / safety rails
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TIMEOUT_SECONDS=30
CRITIC_MAX_RETRIES=2

# ---------- Demo customer + SQLite (the only data store; lives on the EC2 disk) ----------
# Which generated customer scripts/load_customer.py loads: alex (tight budget) | jordan (saver) | sam (gig income)
DEMO_PERSONA=alex
# Last day of generated history. Pin it so every reload/teammate gets identical data (empty = today,
# which changes the random draws every day). Pick the date you rehearse on and keep it for the demo.
DEMO_END_DATE=2026-11-07
# Relative paths are relative to server/. Delete the files and re-run load_customer.py to reset.
# Anonymized transactions/accounts/obligations the engines and agents read.
SQLITE_PATH=./data/copilot.db
# Private lookup (acct_A <-> real names). Never exported, logged or sent to a model.
PRIVATE_DB_PATH=./data/private.db

# ---------- App / backend (AWS EC2) ----------
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Fixed seed for the fake-data generator and Monte Carlo (reproducible demos)
RANDOM_SEED=42
MONTE_CARLO_RUNS=5000

# ---------- Privacy / tracing ----------
# Keep tracing local; cloud tracers store copies of prompts.
LANGCHAIN_TRACING_V2=false
# Canary identifiers planted in test data; the build fails if any appears in an outgoing LLM request.
CANARY_NAME=Zelda Canary
CANARY_ACCOUNT_ID=9999000011112222
CANARY_MERCHANT=Canary Coffee Co
