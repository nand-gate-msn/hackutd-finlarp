    {"key": "income_stability", "value": 0.91, "status": "ok", "formula": "1 - coefficient of variation of monthly income"},
    {"key": "spending_volatility", "value": 0.35, "status": "watch", "formula": "coefficient of variation of weekly variable spending"},
    {"key": "recurring_discretionary_load", "value": 0.06, "status": "ok", "formula": "recurring discretionary payments / income"}
